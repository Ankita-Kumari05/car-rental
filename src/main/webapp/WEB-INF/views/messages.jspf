<%-- Shows an error from a servlet (request attribute "error") or a short message chosen by ?msg=... in the URL --%>
<c:if test="${not empty error}">
    <div class="alert alert-error"><c:out value="${error}" /></div>
</c:if>
<c:if test="${not empty param.msg}">
    <c:choose>
        <c:when test="${param.msg == 'loggedout'}"><div class="alert alert-ok">You have been logged out.</div></c:when>
        <c:when test="${param.msg == 'registered'}"><div class="alert alert-ok">Account created. Log in to continue.</div></c:when>
        <c:when test="${param.msg == 'cancelled'}"><div class="alert alert-ok">Booking cancelled.</div></c:when>
        <c:when test="${param.msg == 'saved'}"><div class="alert alert-ok">Car saved.</div></c:when>
        <c:when test="${param.msg == 'deleted'}"><div class="alert alert-ok">Car deleted.</div></c:when>
        <c:when test="${param.msg == 'updated'}"><div class="alert alert-ok">Booking status updated.</div></c:when>
        <c:when test="${param.msg == 'invalid'}"><div class="alert alert-error">That could not be done. Check the details and try again.</div></c:when>
    </c:choose>
</c:if>
